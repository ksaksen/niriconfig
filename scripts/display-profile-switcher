#!/usr/bin/env python3
import json
import subprocess
import sys


def get_outputs():
    result = subprocess.run(
        ["niri", "msg", "--json", "outputs"],
        capture_output=True, text=True, timeout=3
    )
    return json.loads(result.stdout)


def niri_out(output_name, *args):
    subprocess.run(["niri", "msg", "output", output_name, *args], check=False)


def find_output(outputs, make_contains="", model_contains=""):
    for name, info in outputs.items():
        if make_contains in info.get("make", "") and model_contains in info.get("model", ""):
            return name
    return None


def apply_home(outputs):
    samsung = find_output(outputs, make_contains="Samsung", model_contains="C49RG9x")
    if not samsung:
        notify("Finner ikke Samsung C49RG9x — er den koblet til?")
        return
    niri_out(samsung, "on")
    niri_out(samsung, "mode", "5120x1440@59.977")
    niri_out(samsung, "scale", "1")
    niri_out(samsung, "position", "set", "0", "0")
    laptop = find_output(outputs, make_contains="Sharp")
    if laptop:
        niri_out(laptop, "off")


def apply_office(outputs):
    samsung = find_output(outputs, make_contains="Samsung", model_contains="LS49A950U") \
        or find_output(outputs, make_contains="Samsung")
    if not samsung:
        notify("Finner ikke Samsung LS49A950U — er den koblet til?")
        return
    niri_out(samsung, "on")
    niri_out(samsung, "mode", "5120x1440@120")
    niri_out(samsung, "scale", "1")
    niri_out(samsung, "position", "set", "0", "0")
    niri_out(samsung, "vrr", "on")
    laptop = find_output(outputs, make_contains="Sharp")
    if laptop:
        niri_out(laptop, "off")


def apply_mobile(outputs):
    laptop = find_output(outputs, make_contains="Sharp") or next(iter(outputs))
    niri_out(laptop, "on")
    niri_out(laptop, "mode", "3840x2400@59.994")
    niri_out(laptop, "scale", "2")
    niri_out(laptop, "position", "set", "0", "0")
    for name in outputs:
        if name != laptop:
            niri_out(name, "off")


def notify(msg):
    subprocess.run(["notify-send", "Skjermprofil", msg], check=False)


def restart_kanshi():
    import time
    # Trigger DRM hotplug rescan so niri picks up outputs connected after boot
    subprocess.run(
        ["sudo", "udevadm", "trigger", "--action=change", "--subsystem-match=drm"],
        check=False
    )
    # Wait for niri to process hotplug and then restart kanshi for fresh evaluation
    time.sleep(1.5)
    subprocess.run(["pkill", "kanshi"], check=False)
    time.sleep(0.5)
    subprocess.Popen(["kanshi"])


PROFILES = {
    "home": apply_home,
    "office": apply_office,
    "mobile": apply_mobile,
}


def main():
    choices = list(PROFILES.keys()) + ["restart kanshi", "reload kanshi"]
    result = subprocess.run(
        ["fuzzel", "--dmenu", "--prompt", "Skjermprofil: ", "--width", "28", "--lines", "5"],
        input="\n".join(choices),
        capture_output=True, text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return

    choice = result.stdout.strip()

    if choice == "restart kanshi":
        restart_kanshi()
        return

    if choice == "reload kanshi":
        subprocess.run(["kanshictl", "reload"])
        return

    r = subprocess.run(["kanshictl", "switch", choice], capture_output=True)
    if r.returncode == 0:
        return

    fn = PROFILES.get(choice)
    if fn:
        fn(get_outputs())


if __name__ == "__main__":
    main()
