#!/usr/bin/env bash
set -euo pipefail

log_file="${HOME}/.local/state/niri-set-wallpaper.log"
mkdir -p "$(dirname "${log_file}")"
: > "${log_file}"

log() {
    printf '%(%F %T)T %s\n' -1 "$1" >> "${log_file}"
}

log "started"

wallpaper="${HOME}/.local/share/wallpapers/italy-landscape_5120x1440.jpg"

if [[ ! -f "${wallpaper}" ]]; then
    log "wallpaper not found: ${wallpaper}"
    exit 1
fi

outputs=""
attempt=0
for _ in $(seq 1 60); do
    attempt=$((attempt + 1))
    if outputs="$(niri msg -j outputs 2>/dev/null | jq -r 'to_entries[] | select(.value.logical != null) | .key')" && [[ -n "${outputs}" ]]; then
        log "found outputs after ${attempt} attempt(s): $(tr '\n' ' ' <<< "${outputs}")"
        break
    fi
    sleep 0.5
done

if [[ -z "${outputs}" ]]; then
    log "could not determine any enabled niri outputs after ${attempt} attempts, giving up"
    exit 1
fi

args=()
while IFS= read -r output; do
    [[ -n "${output}" ]] || continue
    args+=(-o "${output}" -i "${wallpaper}" -m fill)
done <<< "${outputs}"

pkill swaybg 2>/dev/null || true
log "launching: swaybg ${args[*]}"
exec swaybg "${args[@]}"
