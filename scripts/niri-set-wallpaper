#!/usr/bin/env bash
set -euo pipefail

wallpaper="${HOME}/.local/share/wallpapers/italy-landscape_5120x1440.jpg"

if [[ ! -f "${wallpaper}" ]]; then
    printf 'wallpaper not found: %s\n' "${wallpaper}" >&2
    exit 1
fi

output=""
for _ in $(seq 1 20); do
    if output="$(niri msg -j focused-output 2>/dev/null | jq -r '.name // empty')" && [[ -n "${output}" ]]; then
        break
    fi
    sleep 0.25
done

if [[ -z "${output}" ]]; then
    printf 'could not determine focused niri output\n' >&2
    exit 1
fi

pkill swaybg 2>/dev/null || true
exec swaybg -o "${output}" -i "${wallpaper}" -m fill
