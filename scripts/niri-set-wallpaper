#!/usr/bin/env bash
set -euo pipefail

wallpaper="${HOME}/.local/share/wallpapers/italy-landscape_5120x1440.jpg"

if [[ ! -f "${wallpaper}" ]]; then
    printf 'wallpaper not found: %s\n' "${wallpaper}" >&2
    exit 1
fi

outputs=""
for _ in $(seq 1 20); do
    if outputs="$(niri msg -j outputs 2>/dev/null | jq -r 'to_entries[] | select(.value.logical != null) | .key')" && [[ -n "${outputs}" ]]; then
        break
    fi
    sleep 0.25
done

if [[ -z "${outputs}" ]]; then
    printf 'could not determine any enabled niri outputs\n' >&2
    exit 1
fi

args=()
while IFS= read -r output; do
    [[ -n "${output}" ]] || continue
    args+=(-o "${output}" -i "${wallpaper}" -m fill)
done <<< "${outputs}"

pkill swaybg 2>/dev/null || true
exec swaybg "${args[@]}"
