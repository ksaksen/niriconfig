#!/usr/bin/env bash
set -euo pipefail

wallpaper="${HOME}/.local/share/wallpapers/italy-landscape_5120x1440.jpg"
log_file="${HOME}/.local/state/niri-set-wallpaper.log"
mkdir -p "$(dirname "${log_file}")"

log() {
    printf '%(%F %T)T %s\n' -1 "$1" >> "${log_file}"
}

last_outputs=""

apply_wallpaper() {
    [[ -f "${wallpaper}" ]] || return 0

    local outputs
    outputs="$(niri msg -j outputs 2>/dev/null | jq -r 'to_entries[] | select(.value.logical != null) | .key' | sort)" || return 0
    [[ -n "${outputs}" ]] || return 0

    if [[ "${outputs}" == "${last_outputs}" ]] && pgrep -f "^swaybg " >/dev/null 2>&1; then
        return 0
    fi

    local args=()
    while IFS= read -r output; do
        [[ -n "${output}" ]] || continue
        args+=(-o "${output}" -i "${wallpaper}" -m fill)
    done <<< "${outputs}"

    pkill -f "^swaybg " 2>/dev/null || true
    log "applying wallpaper for: $(tr '\n' ' ' <<< "${outputs}")"
    swaybg "${args[@]}" &
    disown

    last_outputs="${outputs}"
}

if ! command -v niri >/dev/null 2>&1; then
    log "niri not found in PATH"
    exit 1
fi

log "started"
apply_wallpaper

while true; do
    if ! niri msg event-stream 2>/dev/null | while IFS= read -r _; do
        apply_wallpaper
    done; then
        sleep 1
        continue
    fi

    sleep 1
done
